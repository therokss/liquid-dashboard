{
  "name": "claude-assistant-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "node --env-file-if-exists=../.env.local --import tsx src/index.ts",
    "preview": "node --import tsx test/preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
