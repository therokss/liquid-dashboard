{
  "name": "claude-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "node scripts/release.mjs",
    "check": "npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm test -w server",
